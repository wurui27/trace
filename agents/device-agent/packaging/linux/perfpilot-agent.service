[Unit]
Description=PerfPilot Android Device Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/perfpilot-agent/perfpilot-agent run
WorkingDirectory=/var/lib/perfpilot-agent
Environment=ANDROID_USER_HOME=/var/lib/perfpilot-agent/.android
Restart=on-failure
RestartSec=10s
TimeoutStopSec=5s
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/perfpilot-agent

[Install]
WantedBy=multi-user.target
