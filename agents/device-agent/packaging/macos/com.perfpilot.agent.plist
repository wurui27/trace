<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.perfpilot.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/PerfPilot Agent/perfpilot-agent</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Library/Application Support/PerfPilot Agent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ANDROID_USER_HOME</key>
    <string>/Library/Application Support/PerfPilot Agent/.android</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/PerfPilot Agent/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/PerfPilot Agent/agent-error.log</string>
</dict>
</plist>
