buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 4096
  fill_policy: RING_BUFFER
}
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "power/gpu_frequency"
      ftrace_events: "ftrace/print"
      ftrace_events: "binder/binder_transaction"
      ftrace_events: "binder/binder_transaction_received"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "input"
      atrace_categories: "wm"
      atrace_categories: "am"
      atrace_categories: "binder_driver"
      atrace_apps: "__PACKAGE__"
    }
  }
}
data_sources { config { name: "android.packages_list" target_buffer: 1 } }
data_sources { config { name: "linux.process_stats" target_buffer: 1 } }
data_sources { config { name: "linux.sys_stats" target_buffer: 1 } }
data_sources { config { name: "android.surfaceflinger.frametimeline" target_buffer: 1 } }
data_sources { config { name: "android.input.inputevent" target_buffer: 1 } }
duration_ms: __DURATION_MS__
write_into_file: true
file_write_period_ms: 1000
flush_period_ms: 5000
incremental_state_config { clear_period_ms: 5000 }
