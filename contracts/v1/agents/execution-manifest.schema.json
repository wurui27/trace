{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/agents/execution-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "lease_version",
    "state",
    "started_at",
    "completed_at",
    "agent_version",
    "adb_version",
    "artifacts",
    "scenarios",
    "diagnostic_code"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "execution_id": {"$ref": "#/$defs/uuid"},
    "lease_version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["completed", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "adb_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "diagnostic_code": {
      "oneOf": [
        {"$ref": "#/$defs/stableCode"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
    },
    "stableCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "mime", "size", "sha256_b64"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/uuid"},
        "kind": {"enum": ["startup_trace", "scroll_trace", "memory_evidence", "agent_log"]},
        "mime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "sha256_b64": {"$ref": "#/$defs/sha256"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_type",
        "state",
        "started_at",
        "completed_at",
        "temperature_start_c",
        "temperature_end_c",
        "artifact_ids",
        "diagnostic_code"
      ],
      "properties": {
        "scenario_type": {"enum": ["startup", "scroll", "memory_cycle"]},
        "state": {"enum": ["completed", "failed", "skipped"]},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "temperature_start_c": {
          "oneOf": [
            {"type": "number", "minimum": -100, "maximum": 200},
            {"type": "null"}
          ]
        },
        "temperature_end_c": {
          "oneOf": [
            {"type": "number", "minimum": -100, "maximum": 200},
            {"type": "null"}
          ]
        },
        "artifact_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid"}
        },
        "diagnostic_code": {
          "oneOf": [
            {"$ref": "#/$defs/stableCode"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
