{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/agents/registration-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "access_token",
    "access_token_expires_at",
    "refresh_token",
    "refresh_token_expires_at",
    "task_signing_key",
    "heartbeat_interval_seconds"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "agent_id": {"$ref": "#/$defs/uuid"},
    "team_id": {"$ref": "#/$defs/uuid"},
    "access_token": {"type": "string", "pattern": "^ppat_[A-Za-z0-9_-]{43}$"},
    "access_token_expires_at": {"type": "string", "format": "date-time"},
    "refresh_token": {"type": "string", "pattern": "^pprt_[A-Za-z0-9_-]{43}$"},
    "refresh_token_expires_at": {"type": "string", "format": "date-time"},
    "task_signing_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "public_key_b64"],
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "public_key_b64": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
        }
      }
    },
    "heartbeat_interval_seconds": {"const": 10}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}, "required": ["schema_version"]},
      "then": {"required": ["team_id"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.0"}}, "required": ["schema_version"]},
      "then": {"not": {"required": ["team_id"]}}
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
