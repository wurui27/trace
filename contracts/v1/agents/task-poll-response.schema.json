{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/agents/task-poll-response.schema.json",
  "$comment": "Embedded source-context task limits are fixed protocol constants; patch UTF-8 byte limits are enforced at the signed-task boundary in addition to JSON Schema character limits.",
  "oneOf": [
    {"$ref": "#/$defs/wait"},
    {"$ref": "#/$defs/execute"},
    {"$ref": "#/$defs/cancel"},
    {"$ref": "#/$defs/deviceTask"},
    {"$ref": "#/$defs/sourceTask"}
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "action", "retry_after_seconds"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "action": {"const": "wait"},
        "retry_after_seconds": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "execute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "action",
        "snapshot_jws",
        "lease_expires_at",
        "renew_after_seconds"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "action": {"const": "execute"},
        "snapshot_jws": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32768,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
        },
        "lease_expires_at": {"type": "string", "format": "date-time"},
        "renew_after_seconds": {"const": 20}
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "action",
        "execution_id",
        "lease_version",
        "reason_code"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "action": {"const": "cancel"},
        "execution_id": {"$ref": "#/$defs/uuid"},
        "lease_version": {"type": "integer", "minimum": 1},
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "leaseToken": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "deviceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "aud",
        "agent_id",
        "device_digest",
        "execution_id",
        "lease_version",
        "analysis_id",
        "issued_at",
        "expires_at",
        "package_name",
        "launch_activity",
        "cleanup_policy",
        "input_artifacts",
        "scenarios",
        "allowed_uploads"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "aud": {"const": "perfpilot-agent"},
        "agent_id": {"$ref": "#/$defs/uuid"},
        "device_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_id": {"$ref": "#/$defs/uuid"},
        "lease_version": {"type": "integer", "minimum": 1},
        "analysis_id": {"$ref": "#/$defs/uuid"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "package_name": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"},
        "launch_activity": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^[A-Za-z0-9_.$]+/[A-Za-z0-9_.$]+$"},
        "cleanup_policy": {"enum": ["keep_installed", "uninstall"]},
        "input_artifacts": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/deviceInputArtifact"}},
        "scenarios": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/deviceScenario"}},
        "allowed_uploads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["startup_trace", "scroll_trace", "memory_evidence", "agent_log"]
          }
        }
      }
    },
    "deviceInputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "mime", "size", "sha256_b64"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/uuid"},
        "kind": {"enum": ["apk", "scenario_fixture", "dataset"]},
        "mime": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"},
        "size": {"type": "integer", "minimum": 1, "maximum": 5368709120},
        "sha256_b64": {"$ref": "#/$defs/sha256"}
      }
    },
    "deviceScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_type", "recipe_version", "recipe_hash", "duration_seconds", "memory_rounds", "swipe_count"],
      "properties": {
        "scenario_type": {"enum": ["startup", "scroll", "memory_cycle"]},
        "recipe_version": {"type": "integer", "minimum": 1},
        "recipe_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "memory_rounds": {"type": "integer", "minimum": 0, "maximum": 20},
        "swipe_count": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    },
    "sourceRuleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.]*$"
    },
    "sourceFindingHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "evidence_ids", "rule_id", "symbol_hints"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/uuid"},
        "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}},
        "rule_id": {"$ref": "#/$defs/sourceRuleId"},
        "symbol_hints": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}}
      }
    },
    "sourceContextSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "aud",
        "task_type",
        "execution_id",
        "analysis_id",
        "team_id",
        "agent_id",
        "workspace_id",
        "snapshot_policy",
        "validation_profile_id",
        "lease_version",
        "expires_at",
        "finding_hints",
        "limits"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "aud": {"const": "perfpilot-agent"},
        "task_type": {"const": "source_context"},
        "execution_id": {"$ref": "#/$defs/uuid"},
        "analysis_id": {"$ref": "#/$defs/uuid"},
        "team_id": {"$ref": "#/$defs/uuid"},
        "agent_id": {"$ref": "#/$defs/uuid"},
        "workspace_id": {"$ref": "#/$defs/uuid"},
        "snapshot_policy": {"const": "tracked_worktree"},
        "validation_profile_id": {
          "oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]
        },
        "lease_version": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "string", "format": "date-time"},
        "finding_hints": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceFindingHint"}},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_findings", "max_files", "max_bytes"],
          "properties": {
            "max_findings": {"type": "integer", "const": 3},
            "max_files": {"type": "integer", "const": 12},
            "max_bytes": {"type": "integer", "const": 98304}
          }
        }
      }
    },
    "sourcePatchSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "aud",
        "task_type",
        "execution_id",
        "analysis_id",
        "team_id",
        "agent_id",
        "workspace_id",
        "snapshot_policy",
        "validation_profile_id",
        "lease_version",
        "expires_at",
        "snapshot_id",
        "snapshot_hash",
        "fix_id",
        "patch"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "aud": {"const": "perfpilot-agent"},
        "task_type": {"const": "patch_verification"},
        "execution_id": {"$ref": "#/$defs/uuid"},
        "analysis_id": {"$ref": "#/$defs/uuid"},
        "team_id": {"$ref": "#/$defs/uuid"},
        "agent_id": {"$ref": "#/$defs/uuid"},
        "workspace_id": {"$ref": "#/$defs/uuid"},
        "snapshot_policy": {"const": "tracked_worktree"},
        "validation_profile_id": {"$ref": "#/$defs/uuid"},
        "lease_version": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "string", "format": "date-time"},
        "snapshot_id": {"$ref": "#/$defs/uuid"},
        "snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fix_id": {"$ref": "#/$defs/uuid"},
        "patch": {"type": "string", "minLength": 1, "maxLength": 65536, "$comment": "Also limited to 65,536 UTF-8 bytes by signed-task semantic validation."}
      }
    },
    "deviceTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_kind",
        "lease_token",
        "snapshot",
        "signature_b64"
      ],
      "properties": {
        "schema_version": {"const": "1.1"},
        "task_kind": {"const": "device"},
        "lease_token": {"$ref": "#/$defs/leaseToken"},
        "snapshot": {"$ref": "#/$defs/deviceSnapshot"},
        "signature_b64": {"$ref": "#/$defs/signature"}
      }
    },
    "sourceTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_kind",
        "lease_token",
        "snapshot",
        "signature_b64"
      ],
      "properties": {
        "schema_version": {"const": "1.1"},
        "task_kind": {"const": "source"},
        "lease_token": {"$ref": "#/$defs/leaseToken"},
        "snapshot": {
          "oneOf": [
            {"$ref": "#/$defs/sourceContextSnapshot"},
            {"$ref": "#/$defs/sourcePatchSnapshot"}
          ]
        },
        "signature_b64": {"$ref": "#/$defs/signature"}
      }
    }
  }
}
