{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/agents/task-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {"schema_version": {"const": "1.0"}},
      "not": {
        "anyOf": [
          {"required": ["team_id"]},
          {"required": ["test_type"]},
          {"required": ["launch_mode"]}
        ]
      },
      "allOf": [
        {
          "properties": {
            "package_name": {"$ref": "#/$defs/packageName"},
            "launch_activity": {"$ref": "#/$defs/launchActivity"},
            "input_artifacts": {"minItems": 1}
          }
        }
      ]
    },
    {
      "properties": {"schema_version": {"const": "1.1"}},
      "required": ["team_id"],
      "not": {
        "anyOf": [
          {"required": ["test_type"]},
          {"required": ["launch_mode"]}
        ]
      },
      "allOf": [
        {
          "properties": {
            "package_name": {"$ref": "#/$defs/packageName"},
            "launch_activity": {"$ref": "#/$defs/launchActivity"},
            "input_artifacts": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "allOf": [
                  {"$ref": "#/$defs/inputArtifact"},
                  {"properties": {"kind": {"const": "apk"}}}
                ]
              }
            },
            "scenarios": {
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "allOf": [
                    {"$ref": "#/$defs/scenario"},
                    {"properties": {"scenario_type": {"const": "startup"}}}
                  ]
                },
                {
                  "allOf": [
                    {"$ref": "#/$defs/scenario"},
                    {"properties": {"scenario_type": {"const": "scroll"}}}
                  ]
                }
              ]
            },
            "allowed_uploads": {
              "const": ["startup_trace", "scroll_trace", "agent_log"]
            }
          }
        }
      ]
    },
    {
      "properties": {"schema_version": {"const": "1.2"}},
      "required": ["team_id", "test_type", "launch_mode"],
      "allOf": [
        {
          "properties": {
            "cleanup_policy": {"const": "keep_installed"},
            "input_artifacts": {"maxItems": 0},
            "scenarios": {"minItems": 1, "maxItems": 1}
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "test_type": {"enum": ["cold_start", "hot_start"]},
                "launch_mode": {"const": "automatic"},
                "package_name": {"$ref": "#/$defs/packageName"},
                "launch_activity": {"$ref": "#/$defs/launchActivity"},
                "scenarios": {
                  "prefixItems": [
                    {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"scenario_type": {"const": "startup"}, "duration_seconds": {"minimum": 1}, "memory_rounds": {"const": 0}, "swipe_count": {"const": 0}}}]}
                  ]
                },
                "allowed_uploads": {"const": ["startup_trace", "agent_log"]}
              }
            },
            {
              "properties": {
                "test_type": {"enum": ["cold_start", "hot_start"]},
                "launch_mode": {"const": "manual"},
                "package_name": {"type": "null"},
                "launch_activity": {"type": "null"},
                "scenarios": {
                  "prefixItems": [
                    {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"scenario_type": {"const": "startup"}, "duration_seconds": {"minimum": 1}, "memory_rounds": {"const": 0}, "swipe_count": {"const": 0}}}]}
                  ]
                },
                "allowed_uploads": {"const": ["startup_trace", "agent_log"]}
              }
            },
            {
              "properties": {
                "test_type": {"const": "scroll"},
                "launch_mode": {"const": "manual"},
                "package_name": {"$ref": "#/$defs/packageName"},
                "launch_activity": {"$ref": "#/$defs/launchActivity"},
                "scenarios": {
                  "prefixItems": [
                    {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"scenario_type": {"const": "scroll"}, "duration_seconds": {"minimum": 1}, "memory_rounds": {"const": 0}, "swipe_count": {"const": 0}}}]}
                  ]
                },
                "allowed_uploads": {"const": ["scroll_trace", "agent_log"]}
              }
            }
          ]
        }
      ]
    }
  ],
  "required": [
    "schema_version",
    "aud",
    "agent_id",
    "device_digest",
    "execution_id",
    "lease_version",
    "analysis_id",
    "issued_at",
    "expires_at",
    "package_name",
    "launch_activity",
    "cleanup_policy",
    "input_artifacts",
    "scenarios",
    "allowed_uploads"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2"]},
    "aud": {"const": "perfpilot-agent"},
    "team_id": {"$ref": "#/$defs/uuid"},
    "agent_id": {"$ref": "#/$defs/uuid"},
    "device_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_id": {"$ref": "#/$defs/uuid"},
    "lease_version": {"type": "integer", "minimum": 1},
    "analysis_id": {"$ref": "#/$defs/uuid"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "package_name": {"anyOf": [{"$ref": "#/$defs/packageName"}, {"type": "null"}]},
    "launch_activity": {"anyOf": [{"$ref": "#/$defs/launchActivity"}, {"type": "null"}]},
    "cleanup_policy": {"enum": ["keep_installed", "uninstall"]},
    "input_artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/inputArtifact"}
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "allowed_uploads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["startup_trace", "scroll_trace", "memory_evidence", "agent_log"]
      }
    },
    "test_type": {"enum": ["cold_start", "hot_start", "scroll"]},
    "launch_mode": {"enum": ["automatic", "manual"]}
  },
  "$defs": {
    "packageName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "launchActivity": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_.$]+/[A-Za-z0-9_.$]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "mime", "size", "sha256_b64"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/uuid"},
        "kind": {"enum": ["apk", "scenario_fixture", "dataset"]},
        "mime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 5368709120},
        "sha256_b64": {"$ref": "#/$defs/sha256"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_type",
        "recipe_version",
        "recipe_hash",
        "duration_seconds",
        "memory_rounds",
        "swipe_count"
      ],
      "properties": {
        "scenario_type": {"enum": ["startup", "scroll", "memory_cycle"]},
        "recipe_version": {"type": "integer", "minimum": 1},
        "recipe_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "memory_rounds": {"type": "integer", "minimum": 0, "maximum": 20},
        "swipe_count": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    }
  }
}
