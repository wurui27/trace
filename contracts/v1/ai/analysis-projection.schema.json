{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/ai/analysis-projection.schema.json",
  "$comment": "A bounded, deterministic projection of normalized facts for synthesis. Arrays are ordered by their stable IDs and exclude provider, attempt, storage, external-ID, and timestamp data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "analysis_profile", "question", "scenario_reports", "limitations", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_id": {"$ref": "#/$defs/uuid"},
    "analysis_profile": {"enum": ["auto", "startup", "scroll"]},
    "question": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2000}, {"type": "null"}]},
    "scenario_reports": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/scenario"}},
    "limitations": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/limitation"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "metric": {"type": "object", "additionalProperties": false, "required": ["metric_id", "name", "status", "numeric_value", "unit", "definition", "threshold"], "properties": {"metric_id": {"$ref": "#/$defs/uuid"}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "status": {"enum": ["available", "insufficient_data", "unavailable", "invalid_capture"]}, "numeric_value": {"oneOf": [{"type": "number"}, {"type": "null"}]}, "unit": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 64}, {"type": "null"}]}, "definition": {"type": "string", "minLength": 1, "maxLength": 1000}, "threshold": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/threshold"}]}}, "allOf": [{"if": {"properties": {"status": {"const": "available"}}, "required": ["status"]}, "then": {"properties": {"numeric_value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}}}, "else": {"properties": {"numeric_value": {"type": "null"}}}}]},
    "threshold": {"type": "object", "additionalProperties": false, "required": ["operator", "value", "unit"], "properties": {"operator": {"enum": ["gt", "gte", "lt", "lte", "eq"]}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "rule_id", "kind", "status", "severity", "confidence", "title", "summary", "evidence_ids"], "properties": {"finding_id": {"$ref": "#/$defs/uuid"}, "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "kind": {"enum": ["symptom", "root_cause"]}, "status": {"enum": ["confirmed", "suspected", "insufficient_data", "invalid_capture"]}, "severity": {"enum": ["critical", "warning", "healthy", "informational"]}, "confidence": {"enum": ["high", "medium", "low", "none"]}, "title": {"type": "string", "minLength": 1, "maxLength": 255}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "source", "query_id", "interval_start_ns", "interval_end_ns", "artifact_id", "fields"], "properties": {"evidence_id": {"$ref": "#/$defs/uuid"}, "source": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "query_id": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}, {"type": "null"}]}, "interval_start_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "interval_end_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "artifact_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]}, "fields": {"type": "object", "additionalProperties": false, "maxProperties": 20, "patternProperties": {"^[a-z][a-z0-9_.]{0,127}$": {"oneOf": [{"type": "string", "maxLength": 2000}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}]}}}}},
    "traceHealth": {"type": "object", "additionalProperties": false, "required": ["parse_status", "frame_timeline_coverage", "target_display_coverage", "refresh_mode_coverage"], "properties": {"parse_status": {"enum": ["parsed", "failed", "not_applicable"]}, "frame_timeline_coverage": {"enum": ["available", "unavailable", "insufficient_data", "not_applicable"]}, "target_display_coverage": {"enum": ["available", "unavailable", "insufficient_data", "not_applicable"]}, "refresh_mode_coverage": {"enum": ["available", "unavailable", "insufficient_data", "not_applicable"]}}},
    "traceCapability": {"type": "object", "additionalProperties": false, "required": ["name", "required", "status", "reason"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "required": {"type": "boolean"}, "status": {"enum": ["available", "unavailable", "insufficient_data"]}, "reason": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1000}, {"type": "null"}]}}},
    "limitation": {"type": "object", "additionalProperties": false, "required": ["limitation_id", "code", "summary", "evidence_ids"], "properties": {"limitation_id": {"$ref": "#/$defs/uuid"}, "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "scenario_type", "core_state", "metrics", "findings", "evidence", "trace_health", "trace_capabilities"], "properties": {"scenario_id": {"$ref": "#/$defs/uuid"}, "scenario_type": {"enum": ["startup", "scroll", "memory_cycle"]}, "core_state": {"enum": ["complete", "partial"]}, "metrics": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/metric"}}, "findings": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/finding"}}, "evidence": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}, "trace_health": {"$ref": "#/$defs/traceHealth"}, "trace_capabilities": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/traceCapability"}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["engine_id", "adapter_version", "engine_commit_sha", "engine_image_digest", "source_contract", "result_contract_version", "canonical_artifact_id", "canonical_sha256_b64", "normalizer_version"], "properties": {"engine_id": {"const": "smartperfetto"}, "adapter_version": {"type": "string", "minLength": 1, "maxLength": 128}, "engine_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "engine_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "source_contract": {"const": "workspace-agent-v1"}, "result_contract_version": {"type": "string", "minLength": 1, "maxLength": 128}, "canonical_artifact_id": {"$ref": "#/$defs/uuid"}, "canonical_sha256_b64": {"type": "string", "minLength": 44, "maxLength": 44, "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"}, "normalizer_version": {"type": "string", "minLength": 1, "maxLength": 128}}}
  }
}
