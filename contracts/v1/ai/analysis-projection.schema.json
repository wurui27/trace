{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/ai/analysis-projection.schema.json",
  "$comment": "A deterministic, bounded tenant-private projection. Arrays are ordered by stable public ID; source is an allowlist and has no storage, checksum, provider, attempt, or timestamp data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "analysis_profile", "question", "source", "scenarios", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_id": {"$ref": "#/$defs/uuid"},
    "analysis_profile": {"enum": ["auto", "startup", "scroll"]},
    "question": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2000}, {"type": "null"}]},
    "source": {"$ref": "#/$defs/source"},
    "scenarios": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/scenario"}},
    "limitations": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/limitation"}}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "finiteNumber": {"type": "number", "$comment": "Validation boundaries use the finite-number Draft validator; serialized JSON cannot contain NaN or Infinity."},
    "source": {"type": "object", "additionalProperties": false, "required": ["engine_id", "adapter_version", "source_contract", "canonical_artifact_id"], "properties": {"engine_id": {"const": "smartperfetto"}, "adapter_version": {"type": "string", "minLength": 1, "maxLength": 128}, "source_contract": {"const": "workspace-agent-v1"}, "canonical_artifact_id": {"$ref": "#/$defs/uuid"}}},
    "threshold": {"type": "object", "additionalProperties": false, "required": ["operator", "value", "unit"], "properties": {"operator": {"enum": ["gt", "gte", "lt", "lte", "eq"]}, "value": {"$ref": "#/$defs/finiteNumber"}, "unit": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["metric_id", "name", "status", "numeric_value", "unit", "definition", "threshold"], "properties": {"metric_id": {"$ref": "#/$defs/uuid"}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "status": {"enum": ["available", "insufficient_data", "unavailable", "invalid_capture"]}, "numeric_value": {"oneOf": [{"$ref": "#/$defs/finiteNumber"}, {"type": "null"}]}, "unit": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 64}, {"type": "null"}]}, "definition": {"type": "string", "minLength": 1, "maxLength": 1000}, "threshold": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/threshold"}]}}, "allOf": [{"if": {"properties": {"status": {"const": "available"}}, "required": ["status"]}, "then": {"properties": {"numeric_value": {"$ref": "#/$defs/finiteNumber"}, "unit": {"type": "string", "minLength": 1}}}, "else": {"properties": {"numeric_value": {"type": "null"}}}}]},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "rule_id", "kind", "status", "severity", "confidence", "title", "summary", "evidence_ids"], "properties": {"finding_id": {"$ref": "#/$defs/uuid"}, "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "kind": {"enum": ["symptom", "root_cause"]}, "status": {"enum": ["confirmed", "suspected", "insufficient_data", "invalid_capture"]}, "severity": {"enum": ["critical", "warning", "healthy", "informational"]}, "confidence": {"enum": ["high", "medium", "low", "none"]}, "title": {"type": "string", "minLength": 1, "maxLength": 255}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "source", "query_id", "interval_start_ns", "interval_end_ns", "artifact_id", "fields"], "properties": {"evidence_id": {"$ref": "#/$defs/uuid"}, "source": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "query_id": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}, {"type": "null"}]}, "interval_start_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "interval_end_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "artifact_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]}, "fields": {"type": "object", "additionalProperties": false, "maxProperties": 20, "patternProperties": {"^[a-z][a-z0-9_.]{0,127}$": {"oneOf": [{"type": "string", "maxLength": 2000}, {"$ref": "#/$defs/finiteNumber"}, {"type": "boolean"}, {"type": "null"}]}}}}},
    "limitation": {"type": "object", "additionalProperties": false, "required": ["limitation_id", "code", "summary", "evidence_ids"], "properties": {"limitation_id": {"$ref": "#/$defs/uuid"}, "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "scenario_type", "core_state", "metrics", "findings", "evidence", "limitations"], "properties": {"scenario_id": {"$ref": "#/$defs/uuid"}, "scenario_type": {"enum": ["startup", "scroll", "memory_cycle"]}, "core_state": {"enum": ["complete", "partial"]}, "metrics": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/metric"}}, "findings": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/finding"}}, "evidence": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}, "limitations": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/limitation"}}}}
  }
}
