{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/ai/synthesis-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "executive_summary", "top_findings", "recommendations", "retest_plan", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "executive_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "top_findings": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/topFinding"}},
    "recommendations": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "retest_plan": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/retestItem"}},
    "limitations": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/limitation"}}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "topFinding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "summary", "recommendation"], "properties": {"finding_id": {"$ref": "#/$defs/uuid"}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "recommendation": {"type": "string", "minLength": 1, "maxLength": 2000}}},
    "limitation": {"type": "object", "additionalProperties": false, "required": ["limitation_id", "summary"], "properties": {"limitation_id": {"$ref": "#/$defs/uuid"}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}}},
    "retestItem": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "summary", "metric_ids", "limitation_ids", "success_criterion", "failure_criterion"], "properties": {"mode": {"const": "verify_metric"}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "metric_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}, "limitation_ids": {"type": "array", "maxItems": 0}, "success_criterion": {"enum": ["meet_existing_threshold", "improve_from_baseline"]}, "failure_criterion": {"const": "threshold_missed"}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "summary", "metric_ids", "limitation_ids", "success_criterion", "failure_criterion"], "properties": {"mode": {"const": "collect_evidence"}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "metric_ids": {"type": "array", "maxItems": 0}, "limitation_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}, "success_criterion": {"const": "evidence_collected"}, "failure_criterion": {"const": "evidence_missing"}}}
      ]
    }
  }
}
