{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/analyses/analysis-response.schema.json",
  "$comment": "The same closed shape is used for create and authenticated status reads. Device create responses may include the pending APK authorization; a later GET may omit the authorization pair so reading status does not silently mint a new upload capability. Manual memory_upload responses contain the private normalized question and never contain an APK authorization or device scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "team_id",
    "analysis_mode",
    "state",
    "version",
    "application_version_id",
    "application_metadata",
    "scenarios",
    "sample_verdict_counts",
    "active_lease",
    "report_available",
    "created_at",
    "started_at",
    "completed_at",
    "failure"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2"]},
    "analysis_id": {"type": "string", "format": "uuid"},
    "team_id": {"type": "string", "format": "uuid"},
    "analysis_mode": {"enum": ["device", "trace_upload", "memory_upload"]},
    "device_id": {"type": "string", "format": "uuid"},
    "state": {
      "enum": [
        "creating",
        "created",
        "uploading",
        "queued",
        "scheduled",
        "running",
        "analyzing",
        "completed",
        "partially_completed",
        "failed",
        "canceled",
        "deleted"
      ]
    },
    "version": {"type": "integer", "minimum": 1},
    "application_version_id": {
      "oneOf": [
        {"type": "string", "format": "uuid"},
        {"type": "null"}
      ]
    },
    "application_metadata": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/applicationMetadata"}
      ]
    },
    "apk_upload": {
      "oneOf": [
        {"$ref": "#/$defs/pendingApkUpload"},
        {"$ref": "#/$defs/finalizedApkUpload"},
        {"type": "null"}
      ]
    },
    "scenarios": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/scenarioProgress"},
          {"$ref": "#/$defs/notRequestedMemoryScenario"},
          {"$ref": "#/$defs/scriptScenarioProgress"}
        ]
      }
    },
    "sample_verdict_counts": {"$ref": "#/$defs/verdictCounts"},
    "active_lease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/activeLease"}
      ]
    },
    "report_available": {"type": "boolean"},
    "stages": {"$ref": "#/$defs/traceStages"},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"$ref": "#/$defs/nullableDateTime"},
    "completed_at": {"$ref": "#/$defs/nullableDateTime"},
    "cancel_requested_at": {"$ref": "#/$defs/nullableDateTime"},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/failure"}
      ]
    },
    "question": {
      "oneOf": [
        {"type": "string", "maxLength": 2000},
        {"type": "null"}
      ]
    },
    "analysis_profile": {"enum": ["auto", "startup", "scroll"]},
    "test_type": {"enum": ["cold_start", "hot_start", "scroll", "other"]},
    "package_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "custom_test_name": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 80},
        {"type": "null"}
      ]
    },
    "custom_test_description": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 500},
        {"type": "null"}
      ]
    },
    "input_uploads": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/awaitingInputUpload"},
          {"$ref": "#/$defs/pendingInputUpload"},
          {"$ref": "#/$defs/finalizedInputUpload"}
        ]
      }
    },
    "source_analysis": {"$ref": "#/$defs/sourceAnalysis"},
    "source_code_analysis": {"$ref": "#/$defs/sourceCodeAnalysis"},
    "capture_configuration": {"$ref": "#/$defs/deviceCaptureConfiguration"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "source_analysis": {"$ref": "#/$defs/sourceAnalysis"},
          "source_code_analysis": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.0"},
          "analysis_mode": {"enum": ["device", "memory_upload"]}
        },
        "required": ["schema_version", "analysis_mode"]
      },
      "then": {"properties": {"source_analysis": false}}
    },
    {
      "if": {
        "properties": {"schema_version": {"enum": ["1.1", "1.2"]}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["source_code_analysis"],
        "properties": {
          "analysis_mode": {"enum": ["device", "trace_upload"]}
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "application_version_id": {"type": "null"},
            "application_metadata": {"type": "null"}
          }
        },
        {
          "properties": {
            "application_version_id": {"type": "string", "format": "uuid"},
            "application_metadata": {"$ref": "#/$defs/applicationMetadata"}
          }
        }
      ]
    },
    {
      "if": {
        "properties": {"state": {"const": "failed"}},
        "required": ["state"]
      },
      "then": {
        "properties": {"failure": {"$ref": "#/$defs/failure"}}
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.0"},
          "analysis_mode": {"const": "device"}
        },
        "required": ["schema_version", "analysis_mode"]
      },
      "then": {
        "properties": {"scenarios": {"$ref": "#/$defs/deviceScenarios"}}
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "schema_version": {"enum": ["1.0", "1.1"]},
            "analysis_mode": {"const": "device"},
            "apk_upload": {
              "oneOf": [
                {"$ref": "#/$defs/pendingApkUpload"},
                {"$ref": "#/$defs/finalizedApkUpload"}
              ]
            },
            "scenarios": {"$ref": "#/$defs/compatibleDeviceScenarios"}
          },
          "required": ["analysis_mode", "device_id", "apk_upload"],
          "not": {
            "anyOf": [
              {"required": ["question"]},
              {"required": ["analysis_profile"]},
              {"required": ["input_uploads"]},
              {"required": ["stages"]}
            ]
          }
        },
        {
          "properties": {
            "schema_version": {"const": "1.2"},
            "analysis_mode": {"const": "device"},
            "application_version_id": {"type": "null"},
            "application_metadata": {"type": "null"},
            "capture_configuration": {"$ref": "#/$defs/deviceCaptureConfiguration"},
            "scenarios": {"$ref": "#/$defs/scriptDeviceScenarios"},
            "sample_verdict_counts": {"$ref": "#/$defs/verdictCounts"}
          },
          "required": ["analysis_mode", "device_id", "capture_configuration"],
          "oneOf": [
            {
              "properties": {
                "capture_configuration": {
                  "allOf": [
                    {"$ref": "#/$defs/deviceCaptureConfiguration"},
                    {"properties": {"test_type": {"const": "cold_start"}}}
                  ]
                },
                "scenarios": {"$ref": "#/$defs/coldStartScriptScenarios"}
              }
            },
            {
              "properties": {
                "capture_configuration": {
                  "allOf": [
                    {"$ref": "#/$defs/deviceCaptureConfiguration"},
                    {"properties": {"test_type": {"const": "hot_start"}}}
                  ]
                },
                "scenarios": {"$ref": "#/$defs/hotStartScriptScenarios"}
              }
            },
            {
              "properties": {
                "capture_configuration": {
                  "allOf": [
                    {"$ref": "#/$defs/deviceCaptureConfiguration"},
                    {"properties": {"test_type": {"const": "scroll"}}}
                  ]
                },
                "scenarios": {"$ref": "#/$defs/scrollScriptScenarios"}
              }
            }
          ],
          "not": {
            "anyOf": [
              {"required": ["apk_upload"]},
              {"required": ["question"]},
              {"required": ["analysis_profile"]},
              {"required": ["input_uploads"]},
              {"required": ["stages"]}
            ]
          }
        },
        {
          "properties": {
            "analysis_mode": {"const": "memory_upload"},
            "application_version_id": {"type": "string", "format": "uuid"},
            "application_metadata": {"$ref": "#/$defs/applicationMetadata"},
            "apk_upload": {"type": "null"},
            "scenarios": {"type": "array", "maxItems": 0},
            "sample_verdict_counts": {"$ref": "#/$defs/zeroVerdictCounts"},
            "active_lease": {"type": "null"},
            "report_available": {"const": false},
            "question": {
              "oneOf": [
                {"type": "string", "maxLength": 2000},
                {"type": "null"}
              ]
            }
          },
          "required": ["analysis_mode", "question", "apk_upload"],
          "not": {
            "anyOf": [
              {"required": ["device_id"]},
              {"required": ["analysis_profile"]},
              {"required": ["input_uploads"]},
              {"required": ["stages"]}
            ]
          }
        },
        {
          "properties": {
            "analysis_mode": {"const": "trace_upload"},
            "application_version_id": {"type": "null"},
            "application_metadata": {"type": "null"},
            "apk_upload": {"type": "null"},
            "scenarios": {"type": "array", "maxItems": 0},
            "sample_verdict_counts": {"$ref": "#/$defs/zeroVerdictCounts"},
            "active_lease": {"type": "null"},
            "analysis_profile": {"enum": ["auto", "startup", "scroll"]},
            "test_type": {"enum": ["cold_start", "hot_start", "scroll", "other"]},
            "package_name": {
              "type": "string",
              "minLength": 3,
              "maxLength": 255,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
            },
            "question": {
              "oneOf": [
                {"type": "string", "maxLength": 2000},
                {"type": "null"}
              ]
            },
            "input_uploads": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "oneOf": [
                  {"$ref": "#/$defs/awaitingInputUpload"},
                  {"$ref": "#/$defs/pendingInputUpload"},
                  {"$ref": "#/$defs/finalizedInputUpload"}
                ]
              }
            }
          },
          "required": [
            "analysis_mode",
            "analysis_profile",
            "test_type",
            "package_name",
            "custom_test_name",
            "custom_test_description",
            "question",
            "input_uploads",
            "stages",
            "apk_upload"
          ],
          "oneOf": [
            {
              "properties": {
                "test_type": {"const": "other"},
                "custom_test_name": {"type": "string"},
                "custom_test_description": {"type": "string"}
              }
            },
            {
              "properties": {
                "test_type": {"enum": ["cold_start", "hot_start", "scroll"]},
                "custom_test_name": {"type": "null"},
                "custom_test_description": {"type": "null"}
              }
            }
          ],
          "not": {"required": ["device_id"]}
        }
      ]
    }
  ],
  "$defs": {
    "canonicalUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "stableCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sourceAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "rounds", "verification", "session_id", "run_id"],
      "properties": {
        "engine": {"const": "smartperfetto"},
        "rounds": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "verification": {"enum": ["passed", "failed", "unknown"]},
        "session_id": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 255},
            {"type": "null"}
          ]
        },
        "run_id": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 255},
            {"type": "null"}
          ]
        }
      }
    },
    "sourceCodeAnalysis": {
      "oneOf": [
        {"$ref": "#/$defs/requestedSourceCodeAnalysis"},
        {"$ref": "#/$defs/notRequestedSourceCodeAnalysis"}
      ]
    },
    "requestedSourceCodeAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "provider_kind",
        "agent_id",
        "workspace_id",
        "snapshot_policy",
        "validation_profile_id",
        "context_state",
        "match_summary",
        "verification_state",
        "failure_code"
      ],
      "properties": {
        "requested": {"const": true},
        "provider_kind": {"const": "agent_workspace"},
        "agent_id": {"$ref": "#/$defs/canonicalUuid"},
        "workspace_id": {"$ref": "#/$defs/canonicalUuid"},
        "snapshot_policy": {"const": "tracked_worktree"},
        "validation_profile_id": {
          "oneOf": [
            {"$ref": "#/$defs/canonicalUuid"},
            {"type": "null"}
          ]
        },
        "context_state": {
          "enum": ["waiting_for_agent", "extracting", "available", "unavailable"]
        },
        "match_summary": {"enum": ["strong", "weak", "none"]},
        "verification_state": {
          "enum": [
            "not_requested",
            "pending",
            "validating",
            "verified",
            "apply_failed",
            "validation_failed",
            "source_changed",
            "not_configured",
            "timeout",
            "canceled",
            "unavailable"
          ]
        },
        "failure_code": {
          "oneOf": [
            {"$ref": "#/$defs/stableCode"},
            {"type": "null"}
          ]
        }
      }
    },
    "notRequestedSourceCodeAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "provider_kind",
        "agent_id",
        "workspace_id",
        "snapshot_policy",
        "validation_profile_id",
        "context_state",
        "match_summary",
        "verification_state",
        "failure_code"
      ],
      "properties": {
        "requested": {"const": false},
        "provider_kind": {"type": "null"},
        "agent_id": {"type": "null"},
        "workspace_id": {"type": "null"},
        "snapshot_policy": {"type": "null"},
        "validation_profile_id": {"type": "null"},
        "context_state": {"const": "not_requested"},
        "match_summary": {"const": "none"},
        "verification_state": {"const": "not_requested"},
        "failure_code": {"type": "null"}
      }
    },
    "analysisStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "state", "failure"],
      "properties": {
        "stage": {
          "enum": ["input_validation", "smartperfetto", "perfpilot_ai", "report"]
        },
        "state": {
          "enum": ["pending", "running", "completed", "failed", "canceled", "not_requested"]
        },
        "failure": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/failure"}
          ]
        }
      }
    },
    "traceStages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/analysisStage"},
            {"properties": {"stage": {"const": "input_validation"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/analysisStage"},
            {"properties": {"stage": {"const": "smartperfetto"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/analysisStage"},
            {"properties": {"stage": {"const": "perfpilot_ai"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/analysisStage"},
            {"properties": {"stage": {"const": "report"}}}
          ]
        }
      ],
      "items": false
    },
    "sha256": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
    },
    "nullableDateTime": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,95}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "retryable": {"type": "boolean"}
      }
    },
    "applicationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "version_name",
        "version_code",
        "launch_activity",
        "min_sdk",
        "target_sdk",
        "supported_abis",
        "has_native_libraries"
      ],
      "properties": {
        "package_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "version_name": {
          "oneOf": [
            {"type": "string", "maxLength": 255},
            {"type": "null"}
          ]
        },
        "version_code": {"type": "integer", "minimum": 0},
        "launch_activity": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 512},
            {"type": "null"}
          ]
        },
        "min_sdk": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "target_sdk": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "supported_abis": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["armeabi-v7a", "arm64-v8a", "x86", "x86_64"]
          }
        },
        "has_native_libraries": {"type": "boolean"}
      }
    },
    "requiredHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Content-Type", "x-amz-checksum-sha256"],
      "properties": {
        "Content-Type": {"const": "application/vnd.android.package-archive"},
        "x-amz-checksum-sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputRequiredHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Content-Type", "x-amz-checksum-sha256"],
      "properties": {
        "Content-Type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "x-amz-checksum-sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputKind": {
      "enum": [
        "trace",
        "memory_evidence",
        "apk",
        "source_archive",
        "mapping",
        "native_symbols",
        "log"
      ]
    },
    "awaitingInputUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "artifact_kind",
        "mime",
        "size",
        "sha256_b64"
      ],
      "properties": {
        "state": {"const": "awaiting_upload"},
        "artifact_kind": {"$ref": "#/$defs/inputKind"},
        "mime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 5368709120},
        "sha256_b64": {"$ref": "#/$defs/sha256"}
      }
    },
    "pendingInputUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "upload_id",
        "artifact_kind",
        "mime",
        "size",
        "sha256_b64",
        "expires_at"
      ],
      "properties": {
        "state": {"const": "pending"},
        "upload_id": {"type": "string", "format": "uuid"},
        "artifact_kind": {"$ref": "#/$defs/inputKind"},
        "mime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 5368709120},
        "sha256_b64": {"$ref": "#/$defs/sha256"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "finalizedInputUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "artifact_id",
        "upload_id",
        "artifact_kind",
        "mime",
        "size",
        "sha256_b64",
        "finalized_at"
      ],
      "properties": {
        "state": {"const": "finalized"},
        "artifact_id": {"type": "string", "format": "uuid"},
        "upload_id": {"type": "string", "format": "uuid"},
        "artifact_kind": {"$ref": "#/$defs/inputKind"},
        "mime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "size": {"type": "integer", "minimum": 1, "maximum": 5368709120},
        "sha256_b64": {"$ref": "#/$defs/sha256"},
        "finalized_at": {"type": "string", "format": "date-time"}
      }
    },
    "pendingApkUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "upload_id",
        "artifact_kind",
        "mime",
        "size",
        "sha256_b64",
        "expires_at"
      ],
      "properties": {
        "state": {"const": "pending"},
        "upload_id": {"type": "string", "format": "uuid"},
        "artifact_kind": {"const": "apk"},
        "mime": {"const": "application/vnd.android.package-archive"},
        "size": {"type": "integer", "minimum": 1, "maximum": 5368709120},
        "sha256_b64": {"$ref": "#/$defs/sha256"},
        "expires_at": {"type": "string", "format": "date-time"},
        "put_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "required_headers": {"$ref": "#/$defs/requiredHeaders"}
      },
      "oneOf": [
        {"required": ["put_url", "required_headers"]},
        {
          "not": {
            "anyOf": [
              {"required": ["put_url"]},
              {"required": ["required_headers"]}
            ]
          }
        }
      ]
    },
    "finalizedApkUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "artifact_id",
        "upload_id",
        "artifact_kind",
        "mime",
        "size",
        "sha256_b64",
        "finalized_at"
      ],
      "properties": {
        "state": {"const": "finalized"},
        "artifact_id": {"type": "string", "format": "uuid"},
        "upload_id": {"type": "string", "format": "uuid"},
        "artifact_kind": {"const": "apk"},
        "mime": {"const": "application/vnd.android.package-archive"},
        "size": {"type": "integer", "minimum": 1, "maximum": 5368709120},
        "sha256_b64": {"$ref": "#/$defs/sha256"},
        "finalized_at": {"type": "string", "format": "date-time"}
      }
    },
    "verdictCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "invalid", "pending", "validation_error", "total"],
      "properties": {
        "valid": {"type": "integer", "minimum": 0, "maximum": 10},
        "invalid": {"type": "integer", "minimum": 0, "maximum": 10},
        "pending": {"type": "integer", "minimum": 0, "maximum": 10},
        "validation_error": {"type": "integer", "minimum": 0, "maximum": 10},
        "total": {"type": "integer", "minimum": 0, "maximum": 30}
      }
    },
    "zeroVerdictCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "invalid", "pending", "validation_error", "total"],
      "properties": {
        "valid": {"const": 0},
        "invalid": {"const": 0},
        "pending": {"const": 0},
        "validation_error": {"const": 0},
        "total": {"const": 0}
      }
    },
    "launchTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "launch_activity"],
      "properties": {
        "package_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "launch_activity": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.$]+/[A-Za-z0-9_.$]+$"
        }
      }
    },
    "deviceCaptureConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_type", "launch_mode", "duration_seconds", "target"],
      "properties": {
        "test_type": {"enum": ["cold_start", "hot_start", "scroll"]},
        "launch_mode": {"enum": ["automatic", "manual"]},
        "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "target": {
          "oneOf": [
            {"$ref": "#/$defs/launchTarget"},
            {"type": "null"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "test_type": {"enum": ["cold_start", "hot_start"]},
            "launch_mode": {"const": "automatic"},
            "target": {"$ref": "#/$defs/launchTarget"}
          }
        },
        {
          "properties": {
            "test_type": {"enum": ["cold_start", "hot_start"]},
            "launch_mode": {"const": "manual"},
            "target": {"type": "null"}
          }
        },
        {
          "properties": {
            "test_type": {"const": "scroll"},
            "launch_mode": {"const": "manual"},
            "target": {"$ref": "#/$defs/launchTarget"}
          }
        }
      ]
    },
    "scriptScenarioProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_job_id",
        "scenario_type",
        "state",
        "version",
        "device_group_id",
        "sample_verdict_counts",
        "started_at",
        "completed_at",
        "failure"
      ],
      "properties": {
        "scenario_job_id": {
          "oneOf": [
            {"type": "string", "format": "uuid"},
            {"type": "null"}
          ]
        },
        "scenario_type": {"enum": ["cold_start", "hot_start", "scroll"]},
        "state": {
          "enum": [
            "queued",
            "scheduled",
            "running",
            "analyzing",
            "completed",
            "failed",
            "canceled"
          ]
        },
        "version": {"type": "integer", "minimum": 1},
        "device_group_id": {
          "oneOf": [
            {"type": "string", "format": "uuid"},
            {"type": "null"}
          ]
        },
        "sample_verdict_counts": {"$ref": "#/$defs/verdictCounts"},
        "started_at": {"$ref": "#/$defs/nullableDateTime"},
        "completed_at": {"$ref": "#/$defs/nullableDateTime"},
        "failure": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/failure"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "failed"}},
            "required": ["state"]
          },
          "then": {"properties": {"failure": {"$ref": "#/$defs/failure"}}},
          "else": {"properties": {"failure": {"type": "null"}}}
        }
      ]
    },
    "coldStartScriptScenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/scriptScenarioProgress"},
            {"properties": {"scenario_type": {"const": "cold_start"}}}
          ]
        }
      ],
      "items": false
    },
    "hotStartScriptScenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/scriptScenarioProgress"},
            {"properties": {"scenario_type": {"const": "hot_start"}}}
          ]
        }
      ],
      "items": false
    },
    "scrollScriptScenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/scriptScenarioProgress"},
            {"properties": {"scenario_type": {"const": "scroll"}}}
          ]
        }
      ],
      "items": false
    },
    "scriptDeviceScenarios": {
      "oneOf": [
        {"$ref": "#/$defs/coldStartScriptScenarios"},
        {"$ref": "#/$defs/hotStartScriptScenarios"},
        {"$ref": "#/$defs/scrollScriptScenarios"}
      ]
    },
    "deviceScenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/scenarioProgress"},
            {"properties": {"scenario_type": {"const": "cold_start"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/scenarioProgress"},
            {"properties": {"scenario_type": {"const": "scroll"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/scenarioProgress"},
            {"properties": {"scenario_type": {"const": "memory_cycle"}}}
          ]
        }
      ],
      "items": false
    },
    "remoteDeviceScenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/scenarioProgress"},
            {"properties": {"scenario_type": {"const": "cold_start"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/scenarioProgress"},
            {"properties": {"scenario_type": {"const": "scroll"}}}
          ]
        },
        {"$ref": "#/$defs/notRequestedMemoryScenario"}
      ],
      "items": false
    },
    "compatibleDeviceScenarios": {
      "oneOf": [
        {"$ref": "#/$defs/deviceScenarios"},
        {"$ref": "#/$defs/remoteDeviceScenarios"}
      ]
    },
    "notRequestedMemoryScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_job_id",
        "scenario_type",
        "state",
        "version",
        "device_group_id",
        "sample_verdict_counts",
        "started_at",
        "completed_at",
        "failure"
      ],
      "properties": {
        "scenario_job_id": {"type": "null"},
        "scenario_type": {"const": "memory_cycle"},
        "state": {"const": "not_requested"},
        "version": {"type": "null"},
        "device_group_id": {"type": "null"},
        "sample_verdict_counts": {"$ref": "#/$defs/zeroVerdictCounts"},
        "started_at": {"type": "null"},
        "completed_at": {"type": "null"},
        "failure": {"type": "null"}
      }
    },
    "scenarioProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_job_id",
        "scenario_type",
        "state",
        "version",
        "device_group_id",
        "sample_verdict_counts",
        "started_at",
        "completed_at",
        "failure"
      ],
      "properties": {
        "scenario_job_id": {
          "oneOf": [
            {"type": "string", "format": "uuid"},
            {"type": "null"}
          ]
        },
        "scenario_type": {"enum": ["cold_start", "scroll", "memory_cycle"]},
        "state": {
          "enum": [
            "awaiting_input",
            "queued",
            "scheduled",
            "running",
            "analyzing",
            "completed",
            "failed",
            "canceled"
          ]
        },
        "version": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "device_group_id": {
          "oneOf": [
            {"type": "string", "format": "uuid"},
            {"type": "null"}
          ]
        },
        "sample_verdict_counts": {"$ref": "#/$defs/verdictCounts"},
        "started_at": {"$ref": "#/$defs/nullableDateTime"},
        "completed_at": {"$ref": "#/$defs/nullableDateTime"},
        "failure": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/failure"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "awaiting_input"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "scenario_job_id": {"type": "null"},
              "version": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "scenario_job_id": {"type": "string", "format": "uuid"},
              "version": {"type": "integer", "minimum": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "failed"}},
            "required": ["state"]
          },
          "then": {"properties": {"failure": {"$ref": "#/$defs/failure"}}}
        }
      ]
    },
    "activeLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "device_id", "state", "expires_at"],
      "properties": {
        "lease_id": {"type": "string", "format": "uuid"},
        "device_id": {"type": "string", "format": "uuid"},
        "state": {"const": "active"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
