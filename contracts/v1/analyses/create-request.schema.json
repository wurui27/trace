{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/analyses/create-request.schema.json",
  "$comment": "Idempotency-Key is an HTTP header and is intentionally absent from this closed, analysis_mode-discriminated body. Device APK identity is server-derived after immutable upload finalization; memory_upload binds an existing routed-tenant ApplicationVersion.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analysis_mode", "device_id", "scenarios", "apk"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "analysis_mode": {"const": "device"},
        "device_id": {"type": "string", "format": "uuid"},
        "scenarios": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"const": "cold_start"},
            {"const": "scroll"},
            {"const": "memory_cycle"}
          ],
          "items": false
        },
        "apk": {"$ref": "#/$defs/apkInput"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "analysis_mode",
        "test_type",
        "package_name",
        "inputs"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "analysis_mode": {"const": "trace_upload"},
        "test_type": {"enum": ["cold_start", "hot_start", "scroll", "other"]},
        "package_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "custom_test_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "custom_test_description": {"type": "string", "minLength": 1, "maxLength": 500},
        "question": {
          "oneOf": [
            {"type": "string", "maxLength": 2000},
            {"type": "null"}
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/traceOnlyInput"}
        }
      },
      "oneOf": [
        {
          "properties": {"test_type": {"const": "other"}},
          "required": ["custom_test_name", "custom_test_description"]
        },
        {
          "properties": {
            "test_type": {"enum": ["cold_start", "hot_start", "scroll"]}
          },
          "not": {
            "anyOf": [
              {"required": ["custom_test_name"]},
              {"required": ["custom_test_description"]}
            ]
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "analysis_mode",
        "test_type",
        "package_name",
        "inputs",
        "source_binding"
      ],
      "properties": {
        "schema_version": {"const": "1.1"},
        "analysis_mode": {"const": "trace_upload"},
        "test_type": {"enum": ["cold_start", "hot_start", "scroll", "other"]},
        "package_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "custom_test_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "custom_test_description": {"type": "string", "minLength": 1, "maxLength": 500},
        "question": {
          "oneOf": [
            {"type": "string", "maxLength": 2000},
            {"type": "null"}
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/traceOnlyInput"}
        },
        "source_binding": {"$ref": "#/$defs/sourceBinding"}
      },
      "oneOf": [
        {
          "properties": {"test_type": {"const": "other"}},
          "required": ["custom_test_name", "custom_test_description"]
        },
        {
          "properties": {
            "test_type": {"enum": ["cold_start", "hot_start", "scroll"]}
          },
          "not": {
            "anyOf": [
              {"required": ["custom_test_name"]},
              {"required": ["custom_test_description"]}
            ]
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analysis_mode", "application_version_id"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "analysis_mode": {"const": "memory_upload"},
        "application_version_id": {"type": "string", "format": "uuid"},
        "question": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]*|[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]*[^\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000](?:(?:.|\\n|\\r|\\u2028|\\u2029){0,1998}[^\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000])?[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]*)$",
              "$comment": "The explicit boundary set matches Python str.strip whitespace exactly (including U+001C-U+001F and excluding U+FEFF). Blank input remains unlimited because the service normalizes it to null; otherwise trimmed content is limited to 2000 Unicode characters, including newlines."
            },
            {"type": "null"}
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analysis_mode", "device_id", "scenarios", "apk"],
      "properties": {
        "schema_version": {"const": "1.1"},
        "analysis_mode": {"const": "device"},
        "device_id": {"type": "string", "format": "uuid"},
        "scenarios": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"const": "cold_start"},
            {"const": "scroll"},
            {"const": "memory_cycle"}
          ],
          "items": false
        },
        "apk": {"$ref": "#/$defs/apkInput"},
        "source_binding": {"$ref": "#/$defs/sourceBinding"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "analysis_mode",
        "device_id",
        "test_type",
        "launch_mode",
        "duration_seconds",
        "target"
      ],
      "properties": {
        "schema_version": {"const": "1.2"},
        "analysis_mode": {"const": "device"},
        "device_id": {"$ref": "#/$defs/uuid"},
        "test_type": {"enum": ["cold_start", "hot_start", "scroll"]},
        "launch_mode": {"enum": ["automatic", "manual"]},
        "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "target": {
          "oneOf": [
            {"$ref": "#/$defs/launchTarget"},
            {"type": "null"}
          ]
        },
        "source_binding": {"$ref": "#/$defs/sourceBinding"}
      },
      "oneOf": [
        {
          "properties": {
            "test_type": {"enum": ["cold_start", "hot_start"]},
            "launch_mode": {"const": "automatic"},
            "target": {"$ref": "#/$defs/launchTarget"}
          }
        },
        {
          "properties": {
            "test_type": {"enum": ["cold_start", "hot_start"]},
            "launch_mode": {"const": "manual"},
            "target": {"type": "null"}
          }
        },
        {
          "properties": {
            "test_type": {"const": "scroll"},
            "launch_mode": {"const": "manual"},
            "target": {"$ref": "#/$defs/launchTarget"}
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "analysis_mode",
        "analysis_profile",
        "inputs"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "analysis_mode": {"const": "trace_upload_legacy_removed"},
        "analysis_profile": {"enum": ["auto", "startup", "scroll"]},
        "question": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]*|[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]*[^\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000](?:(?:.|\\n|\\r|\\u2028|\\u2029){0,1998}[^\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000])?[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]*)$"
            },
            {"type": "null"}
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/traceAnalysisInput"},
          "allOf": [
            {
              "contains": {
                "properties": {"kind": {"const": "trace"}},
                "required": ["kind"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "memory_evidence"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "apk"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "source_archive"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "mapping"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "native_symbols"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "log"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        }
      },
      "not": {}
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "analysis_mode",
        "analysis_profile",
        "inputs"
      ],
      "properties": {
        "schema_version": {"const": "1.1"},
        "analysis_mode": {"const": "trace_upload_legacy_removed"},
        "analysis_profile": {"enum": ["auto", "startup", "scroll"]},
        "question": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]*|[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]*[^\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000](?:(?:.|\\n|\\r|\\u2028|\\u2029){0,1998}[^\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000])?[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028-\\u2029\\u202F\\u205F\\u3000]*)$"
            },
            {"type": "null"}
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/traceAnalysisInput"},
          "allOf": [
            {
              "contains": {
                "properties": {"kind": {"const": "trace"}},
                "required": ["kind"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "memory_evidence"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "apk"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "source_archive"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "mapping"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "native_symbols"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {"kind": {"const": "log"}},
                "required": ["kind"]
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        },
        "source_binding": {"$ref": "#/$defs/sourceBinding"}
      },
      "not": {}
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_kind",
        "agent_id",
        "workspace_id",
        "snapshot_policy",
        "validation_profile_id"
      ],
      "properties": {
        "provider_kind": {"const": "agent_workspace"},
        "agent_id": {"$ref": "#/$defs/uuid"},
        "workspace_id": {"$ref": "#/$defs/uuid"},
        "snapshot_policy": {"const": "tracked_worktree"},
        "validation_profile_id": {
          "oneOf": [
            {"$ref": "#/$defs/uuid"},
            {"type": "null"}
          ]
        }
      }
    },
    "launchTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "launch_activity"],
      "properties": {
        "package_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "launch_activity": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.$]+/[A-Za-z0-9_.$]+$"
        }
      }
    },
    "apkInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "mime", "size", "sha256_b64"],
      "properties": {
        "artifact_kind": {"const": "apk"},
        "mime": {"const": "application/vnd.android.package-archive"},
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5368709120
        },
        "sha256_b64": {"$ref": "#/$defs/sha256"}
      }
    },
    "traceAnalysisInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mime", "size", "sha256_b64"],
      "properties": {
        "kind": {
          "enum": [
            "trace",
            "memory_evidence",
            "apk",
            "source_archive",
            "mapping",
            "native_symbols",
            "log"
          ]
        },
        "mime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5368709120
        },
        "sha256_b64": {"$ref": "#/$defs/sha256"}
      }
    },
    "traceOnlyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mime", "size", "sha256_b64"],
      "properties": {
        "kind": {"const": "trace"},
        "mime": {"const": "application/octet-stream"},
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5368709120
        },
        "sha256_b64": {"$ref": "#/$defs/sha256"}
      }
    },
    "sha256": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$",
      "$comment": "Canonical RFC 4648 standard Base64 encoding of exactly 32 SHA-256 bytes."
    }
  }
}
