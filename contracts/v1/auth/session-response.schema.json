{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/auth/session-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "csrf_token"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "csrf_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
