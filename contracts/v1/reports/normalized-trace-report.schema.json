{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfpilot.internal/contracts/v1/reports/normalized-trace-report.schema.json",
  "$comment": "Deterministic SmartPerfetto facts only. Arrays are emitted in their stable public-ID order; no timestamps, provider details, or storage locations are allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "analysis_mode", "core_state", "scenario_reports", "limitations", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_id": {"$ref": "#/$defs/uuid"},
    "analysis_mode": {"const": "trace_upload"},
    "core_state": {"enum": ["complete", "partial"]},
    "scenario_reports": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/scenario"}},
    "limitations": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/limitation"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "finiteNumber": {"type": "number", "$comment": "Validation boundaries use the finite-number Draft validator; serialized JSON cannot contain NaN or Infinity."},
    "nullableNumber": {"oneOf": [{"$ref": "#/$defs/finiteNumber"}, {"type": "null"}]},
    "threshold": {"type": "object", "additionalProperties": false, "required": ["operator", "value", "unit"], "properties": {"operator": {"enum": ["gt", "gte", "lt", "lte", "eq"]}, "value": {"$ref": "#/$defs/finiteNumber"}, "unit": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["metric_id", "name", "status", "numeric_value", "unit", "definition", "threshold", "sample_ids"], "properties": {"metric_id": {"$ref": "#/$defs/uuid"}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "status": {"enum": ["available", "insufficient_data", "unavailable", "invalid_capture"]}, "numeric_value": {"$ref": "#/$defs/nullableNumber"}, "unit": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 64}, {"type": "null"}]}, "definition": {"type": "string", "minLength": 1, "maxLength": 1000}, "threshold": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/threshold"}]}, "sample_ids": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}, "allOf": [{"if": {"properties": {"status": {"const": "available"}}, "required": ["status"]}, "then": {"properties": {"numeric_value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}}}, "else": {"properties": {"numeric_value": {"type": "null"}}}}]},
    "evidenceValue": {"oneOf": [{"type": "string", "maxLength": 2000}, {"$ref": "#/$defs/finiteNumber"}, {"type": "boolean"}, {"type": "null"}, {"type": "array", "maxItems": 20, "items": {"oneOf": [{"type": "string", "maxLength": 2000}, {"$ref": "#/$defs/finiteNumber"}, {"type": "boolean"}, {"type": "null"}]}}]},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "source", "query_id", "interval_start_ns", "interval_end_ns", "artifact_id", "fields"], "properties": {"evidence_id": {"$ref": "#/$defs/uuid"}, "source": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "query_id": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}, {"type": "null"}]}, "interval_start_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "interval_end_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "artifact_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]}, "fields": {"type": "object", "additionalProperties": false, "patternProperties": {"^[a-z][a-z0-9_.]{0,127}$": {"$ref": "#/$defs/evidenceValue"}}}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "rule_id", "kind", "status", "severity", "confidence", "confidence_ceiling", "title", "summary", "evidence_ids", "exclusions", "recommendation", "retest"], "properties": {"finding_id": {"$ref": "#/$defs/uuid"}, "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "kind": {"enum": ["symptom", "root_cause"]}, "status": {"enum": ["confirmed", "suspected", "insufficient_data", "invalid_capture"]}, "severity": {"enum": ["critical", "warning", "healthy", "informational"]}, "confidence": {"enum": ["high", "medium", "low", "none"]}, "confidence_ceiling": {"enum": ["high", "medium", "low", "none"]}, "title": {"type": "string", "minLength": 1, "maxLength": 255}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}, "exclusions": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/exclusion"}}, "recommendation": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2000}, {"type": "null"}]}, "retest": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2000}, {"type": "null"}]}}},
    "exclusion": {"type": "object", "additionalProperties": false, "required": ["code", "status", "evidence_ids"], "properties": {"code": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "status": {"enum": ["excluded", "not_excluded", "unknown"]}, "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}},
    "targetResolution": {"type": "object", "additionalProperties": false, "required": ["package_name", "process_name", "upid", "pid", "main_thread_id"], "properties": {"package_name": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "process_name": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "upid": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "pid": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "main_thread_id": {"oneOf": [{"type": "integer"}, {"type": "null"}]}}},
    "measurementWindow": {"type": "object", "additionalProperties": false, "required": ["start_ns", "end_ns", "coverage"], "properties": {"start_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "end_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "coverage": {"enum": ["complete", "partial", "missing"]}}},
    "dataLoss": {"type": "object", "additionalProperties": false, "required": ["buffer_overruns", "ftrace_events_lost", "traced_buf_patches_failed", "incomplete_slices", "boundary_truncations"], "properties": {"buffer_overruns": {"type": "integer", "minimum": 0}, "ftrace_events_lost": {"type": "integer", "minimum": 0}, "traced_buf_patches_failed": {"type": "integer", "minimum": 0}, "incomplete_slices": {"type": "integer", "minimum": 0}, "boundary_truncations": {"type": "integer", "minimum": 0}}},
    "traceHealth": {"type": "object", "additionalProperties": false, "required": ["parse_status", "trace_start_ns", "trace_end_ns", "target_resolution", "measurement_window", "data_loss", "frame_timeline_coverage", "target_display_coverage", "refresh_mode_coverage"], "properties": {"parse_status": {"enum": ["parsed", "failed", "not_applicable"]}, "trace_start_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "trace_end_ns": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "target_resolution": {"$ref": "#/$defs/targetResolution"}, "measurement_window": {"$ref": "#/$defs/measurementWindow"}, "data_loss": {"$ref": "#/$defs/dataLoss"}, "frame_timeline_coverage": {"enum": ["available", "unavailable", "insufficient_data", "not_applicable"]}, "target_display_coverage": {"enum": ["available", "unavailable", "insufficient_data", "not_applicable"]}, "refresh_mode_coverage": {"enum": ["available", "unavailable", "insufficient_data", "not_applicable"]}}},
    "traceCapability": {"type": "object", "additionalProperties": false, "required": ["name", "required", "status", "reason"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "required": {"type": "boolean"}, "status": {"enum": ["available", "unavailable", "insufficient_data"]}, "reason": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1000}, {"type": "null"}]}}},
    "limitation": {"type": "object", "additionalProperties": false, "required": ["limitation_id", "code", "summary", "evidence_ids"], "properties": {"limitation_id": {"$ref": "#/$defs/uuid"}, "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,127}$"}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "scenario_type", "core_state", "metrics", "findings", "evidence", "trace_health", "trace_capabilities"], "properties": {"scenario_id": {"$ref": "#/$defs/uuid"}, "scenario_type": {"enum": ["startup", "scroll", "memory_cycle"]}, "core_state": {"enum": ["complete", "partial"]}, "metrics": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/metric"}}, "findings": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/finding"}}, "evidence": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}, "trace_health": {"$ref": "#/$defs/traceHealth"}, "trace_capabilities": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/traceCapability"}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["engine_id", "adapter_version", "engine_commit_sha", "engine_image_digest", "source_contract", "result_contract_version", "canonical_artifact_id", "canonical_sha256_b64", "normalizer_version"], "properties": {"engine_id": {"const": "smartperfetto"}, "adapter_version": {"type": "string", "minLength": 1, "maxLength": 128}, "engine_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "engine_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "source_contract": {"const": "workspace-agent-v1"}, "result_contract_version": {"type": "string", "minLength": 1, "maxLength": 128}, "canonical_artifact_id": {"$ref": "#/$defs/uuid"}, "canonical_sha256_b64": {"type": "string", "minLength": 44, "maxLength": 44, "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"}, "normalizer_version": {"type": "string", "minLength": 1, "maxLength": 128}}}
  }
}
