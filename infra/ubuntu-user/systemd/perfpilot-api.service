[Unit]
Description=PerfPilot server test API
Wants=network-online.target perfpilot-smartperfetto.service
Requires=perfpilot-reset-analysis-data.service
After=network-online.target perfpilot-reset-analysis-data.service perfpilot-smartperfetto.service
PartOf=perfpilot.target
RefuseManualStart=yes

[Service]
Type=simple
WorkingDirectory=%h/perfpilot/platform
EnvironmentFile=%h/perfpilot/config/perfpilot.env
EnvironmentFile=-%h/perfpilot/config/perfpilot-ai.env
ExecStart=%h/perfpilot/platform/.venv/bin/uvicorn --factory perfpilot_api.local_app:create_local_app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
UMask=0077
