[Unit]
Description=PerfPilot production web server
Wants=network-online.target perfpilot-api.service
Requires=perfpilot-reset-analysis-data.service
After=network-online.target perfpilot-reset-analysis-data.service perfpilot-api.service
PartOf=perfpilot.target
RefuseManualStart=yes

[Service]
Type=simple
WorkingDirectory=%h/perfpilot/platform
EnvironmentFile=%h/perfpilot/config/perfpilot.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
UMask=0077
